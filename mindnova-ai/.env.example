# Empty: browser calls /api through the Next.js proxy (recommended).
# Or set a backend origin/API root for direct browser requests (requires CORS).
NEXT_PUBLIC_API_URL=
# Server-side requests and /api proxy target; origin or URL ending in /api.
BACKEND_URL=http://127.0.0.1:8000
# Set these separately for the actual WebSocket service in each environment.
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_APP_KEY=mindnova_chat_key
NEXT_PUBLIC_REVERB_SCHEME=http
